{
  "name": "viimk-uniapp",
  "version": "1.0.0",
  "description": "VIIMK 短剧视频 App - uniapp 多端实现",
  "private": true,
  "scripts": {
    "dev": "bash ./start.sh h5",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "py:start": ".venv/bin/python server.py",
    "py:install": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-components": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5020320260731001",
    "hls.js": "^1.5.13",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-5020320260731001",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-5020320260731001",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5020320260731001",
    "@vue/runtime-core": "^3.4.21",
    "sass": "^1.77.0",
    "vite": "5.2.8"
  }
}
